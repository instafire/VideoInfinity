# =====================================================================
# Video Infinity - Git Ignore Configuration
# Ensures NO private videos, pictures, media, or local databases leak
# =====================================================================

# 1. Media Files (Global Blacklist - Never publish private media)
*.mp4
*.MP4
*.mov
*.MOV
*.avi
*.mkv
*.webm
*.flv
*.wmv
*.m4v
*.mp3
*.wav
*.ogg
*.m4a
*.aac
*.flac
*.wma
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.bmp
*.tiff
*.ico
*.raw
*.heic

# 2. Uploads, Clips, Thumbnails & Exports Folders
public/videos/*
!public/videos/.gitkeep
public/clips/*
!public/clips/.gitkeep
public/thumbnails/*
!public/thumbnails/.gitkeep
public/exports/*
!public/exports/.gitkeep
public/audio/*
!public/audio/.gitkeep
public/images/*
!public/images/.gitkeep

public_new/videos/*
!public_new/videos/.gitkeep
public_new/clips/*
!public_new/clips/.gitkeep
public_new/thumbnails/*
!public_new/thumbnails/.gitkeep
public_new/exports/*
!public_new/exports/.gitkeep
public_new/audio/*
!public_new/audio/.gitkeep
public_new/images/*
!public_new/images/.gitkeep
public_new/temp/*
public_new/backups/*

uploads/*
!uploads/.gitkeep
published_builds/*
!published_builds/.gitkeep

# 3. Local SQLite Databases & Data Files
database.sqlite
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.db

# 4. Test Results, Screenshots & Reports
screenshots/
test-results/
test-results-new/
playwright-report/
blob-report/
.last-run.json

# 5. Dependencies
node_modules/

# 6. Old Backups, Temporary Files & Workspace-Specific Notes
VideoStudio Old/
.tmp/
.claude/
AGENTS.md

# 7. Environment Variables & Secrets
.env
.env.*
*.local

# 8. Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 9. OS & IDE Metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
nul
